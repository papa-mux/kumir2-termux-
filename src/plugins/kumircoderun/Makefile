# target to build an object file
util.cpp.o:
	cd /data/data/com.termux/files/home/хуйня/kumir2/build && $(MAKE) $(MAKESILENT) -f src/plugins/kumircoderun/CMakeFiles/KumirCodeRun.dir/build.make src/plugins/kumircoderun/CMakeFiles/KumirCodeRun.dir/util.cpp.o
.PHONY : util.cpp.o

